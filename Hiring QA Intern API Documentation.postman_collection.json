    {
      "name": "3-Get all the users",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const resbody=pm.response.json();\r",
              "const ids=resbody.map(e=>e.id);\r",
              "console.log(\"ids=\",ids);\r",
              "pm.variables.set(\"id_s\",ids);"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://qa-testing-eight.vercel.app/users",
          "protocol": "https",

  "item": [
    {
      "name": "1-create a user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const reqbody=pm.request.body.raw;\r",
              "function namerandom()\r",
              "{\r",
              "    return Math.random().toString(36).substring(3);\r",
              "}\r",
              "const emailid=\"auto\"+namerandom()+\"@gmail.com\";\r",
              "const jsbody=JSON.parse(reqbody);\r",
              "jsbody.email=emailid;\r",
              "pm.request.body.raw=jsbody;\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const reqbody=pm.request.body.raw;\r",
              "const resbody=pm.response.json();\r",
              "console.log(\"request email=\",reqbody.email);\r",
              "console.log(\"response email=\",resbody.email);\r",
              "pm.test(\"checking the email\",function()\r",
              "{\r",
              "    pm.expect(reqbody.email).to.eql(resbody.email);\r",
              "})\r",
              "const id=resbody.id;\r",
              "pm.variables.set(\"single_id\",id);\r",
              "console.log(\"single-id=\",id);"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"{{$randomFullName}}\",\r\n  \"age\": 30\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://qa-testing-eight.vercel.app/users",
          "protocol": "https",
          "host": [
            "qa-testing-eight",
            "vercel",
            "app"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },

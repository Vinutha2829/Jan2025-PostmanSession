    {
      "name": "4-call a post call and get user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const resbody=pm.response.json();\r",
              "console.log(\"ids=\",resbody.id);"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "function email()\r",
              "{\r",
              "    return Math.random().toString(36).substring(3);\r",
              "}\r",
              "\r",
              "pm.sendRequest(\r",
              "    {\r",
              "        url:\"https://qa-testing-eight.vercel.app/users\",\r",
              "        method:\"POST\",\r",
              "        header:\r",
              "        {\r",
              "            \"Content-Type\":\"application/json\"\r",
              "        },\r",
              "        body:\r",
              "        {\r",
              "            mode:\"raw\",\r",
              "            raw:JSON.stringify(\r",
              "           {\r",
              "            \"name\": \"vinutha\",\r",
              "            \"email\":\"auto\"+email()+\"@gmail.com\",\r",
              "            \"age\": 30\r",
              "            })\r",
              "        }\r",
              "\r",
              "    },function(error,result)\r",
              "    {\r",
              "        if(error)\r",
              "        {\r",
              "            console.log(error);\r",
              "        }\r",
              "        else\r",
              "        {\r",
              "    const jsbody=JSON.parse(result.text());\r",
              "    const id=jsbody.id;\r",
              "\r",
              "    pm.variables.set(\"ids\",id);\r",
              "        }\r",
              "    })\r",
              "\r",
              "  "
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://qa-testing-eight.vercel.app/users/{{ids}}",
          "protocol": "https",
          "host": [
            "qa-testing-eight",
            "vercel",
            "app"
          ],
          "path": [
            "users",
            "{{ids}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "5-update the all user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const req=pm.request.body.raw;\r",
              "function email()\r",
              "{\r",
              "   return  Math.random().toString(36).substring(3);\r",
              "}\r",
              "const js=JSON.parse(req);\r",
              "const emailid=\"auto\"+email()+\"@gmail.com\";\r",
              "js.email=emailid;\r",
              "pm.request.body.raw=js;\r",
              "\r",
              "const ids=pm.variables.get(\"id_s\");\r",
              "const id=ids.shift();\r",
              "pm.variables.set(\"single_id\",id);\r",
              "if(Array.isArray(ids)&& ids.length>0)\r",
              "{\r",
              "    pm.execution.setNextRequest(\"5-update the all user\");\r",
              "}\r",
              "else\r",
              "{\r",
              "    pm.execution.setNextRequest(null);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"Selenium\",\r\n  \"age\": 30\r\n}\r\n",
          "options": {
            "raw": {

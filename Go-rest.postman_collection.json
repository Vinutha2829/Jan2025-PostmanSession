          "script": {
            "exec": [
              "const ids=pm.collectionVariables.get(\"Ids\");\r",
              "const id=ids.shift();\r",
              "pm.variables.set(\"singleid\",id);\r",
              "pm.collectionVariables.set(\"Ids\",ids);\r",
              "\r",
              "if(ids.length>0 && Array.isArray(ids))\r",
              "{\r",
              " pm.execution.setNextRequest(\"3.GET user status\");\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}

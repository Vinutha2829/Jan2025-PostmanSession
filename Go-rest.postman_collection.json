    {
      "name": "1-Get all uers",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const resBody=pm.response.json();\r",
              "const ids=resBody.filter(e=>e.gender==\"female\").map(e=>e.id);\r",
              "pm.collectionVariables.set(\"userIds\",ids);\r",
              "console.log(ids);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],

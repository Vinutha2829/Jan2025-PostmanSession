        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://gorest.in/public/v2/users",
          "protocol": "https",
          "host": [
            "gorest",
            "in"
          ],
          "path": [
            "public",
            "v2",
            "users"
          ]
        }
      },
      "response": []
    },

      "name": "New Request",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const ids=pm.collectionVariables.get(\"userIds\");\r",
              "pm.collectionVariables.set(\"Ids\",ids);\r",
              "const id=ids.shift();\r",
              "pm.variables.set(\"userId\",id);\r",
              "pm.collectionVariables.set(\"userIds\",ids);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
